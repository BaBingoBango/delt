string yyyy-mm-dd\\\\\\\\n}\\\\\\\\n\\\\\\\\n// Utility: convert S3 getObject Body to string\\\\\\\\nconst streamToString = async (stream: Readable | undefined): Promise<string> => {\\\\\\\\n  if (!stream) return \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\";\\\\\\\\n  const chunks: Uint8Array[] = [];\\\\\\\\n  for await (const chunk of stream) {\\\\\\\\n    chunks.push(typeof chunk === \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\" ? Buffer.from(chunk) : chunk);\\\\\\\\n  }\\\\\\\\n  return Buffer.concat(chunks).toString(\\\\\\\\\\\\\\\"utf-8\\\\\\\\\\\\\\\");\\\\\\\\n};\\\\\\\\n\\\\\\\\n/**\\\\\\\\n * Given a key like news-source/2023-09-15-my-post.md\\\\\\\\n * returns {date: \\\\\\\\\\\\\\\"2023-09-15\\\\\\\\\\\\\\\", slug: \\\\\\\\\\\\\\\"my-post\\\\\\\\\\\\\\\"}\\\\\\\\n */\\\\\\\\nexport const parseSourceKey = (key: string) => {\\\\\\\\n  const base = path.basename(key, path.extname(key)); // 2023-09-15-my-post\\\\\\\\n  const match = base.match(/(\\\\\\\\\\\\\\\\d{4}-\\\\\\\\\\\\\\\\d{2}-\\\\\\\\\\\\\\\\d{2})-(.+)/);\\\\\\\\n  if (!match) throw new Error(`Invalid filename format: ${key}`);\\\\\\\\n  return { date: match[1], slug: match[2] };\\\\\\\\n};\\\\\\\\n\\\\\\\\n/**\\\\\\\\n * Extract the first markdown heading (# Title) as the post title.\\\\\\\\n * Fallback to slug if not found.\\\\\\\\n */\\\\\\\\nexport const extractTitle = (markdown: string, slug: string): string => {\\\\\\\\n  const lines = markdown.split(/\\\\\\\\\\\\\\\\r?\\\\\\\\\\\\\\\\n/);\\\\\\\\n  for (const line of lines) {\\\\\\\\n    const m = line.match(/^#\\\\\\\\\\\\\\\\s+(.*)/);\\\\\\\\n    if (m) return m[1].trim();\\\\\\\\n  }\\\\\\\\n  return slug.replace(/-/g, \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\");\\\\\\\\n};\\\\\\\\n\\\\\\\\n/**\\\\\\\\n * Convert markdown to HTML using unified pipeline.\\\\\\\\n */\\\\\\\\nexport const mdToHtml = async (markdown: string): Promise<string> => {\\\\\\\\n  const file = await unified().use(remarkParse).use(remarkHtml).process(markdown);\\\\\\\\n  return String(file);\\\\\\\\n};\\\\\\\\n\\\\\\\\n/**\\\\\\\\n * Main Lambda handler.\\\\\\\\n */\\\\\\\\nexport const handler = async (event: S3Event) => {\\\\\\\\n  const bucket = event.Records[0].s3.bucket.name;\\\\\\\\n\\\\\\\\n  // 1. List up to MAX_POSTS markdown objects under news-source/\\\\\\\\n  const listResp = await s3.send(\\\\\\\\n    new ListObjectsV2Command({\\\\\\\\n      Bucket: bucket,\\\\\\\\n      Prefix: \\\\\\\\\\\\\\\"news-source/\\\\\\\\\\\\\\\",\\\\\\\\n      MaxKeys: MAX_POSTS,\\\\\\\\n    })\\\\\\\\n  );\\\\\\\\n\\\\\\\\n  const objects = listResp.Contents ?? [];\\\\\\\\n  const feed: FeedPost[] = [];\\\\\\\\n  const invalidatePaths: string[] = [];\\\\\\\\n\\\\\\\\n  for (const obj of objects) {\\\\\\\\n    if (!obj.Key || obj.Key.endsWith(\\\\\\\\\\\\\\\"/\\\\\\\\\\\\\\\")) continue; // skip folders\\\\\\\\n    await processObject(bucket, obj, feed, invalidatePaths);\\\\\\\\n  }\\\\\\\\n\\\\\\\\n  // 2. Write/Update feed.json\\\\\\\\n  await s3.send(\\\\\\\\n    new PutObjectCommand({\\\\\\\\n      Bucket: bucket,\\\\\\\\n      Key: \\\\\\\\\\\\\\\"news/feed.json\\\\\\\\\\\\\\\",\\\\\\\\n      Body: JSON.stringify(feed, null, 2),\\\\\\\\n      ContentType: \\\\\\\\\\\\\\\"application/json\\\\\\\\\\\\\\\",\\\\\\\\n    })\\\\\\\\n  );\\\\\\\\n  invalidatePaths.push(\\\\\\\\\\\\\\\"/news/feed.json\\\\\\\\\\\\\\\");\\\\\\\\n\\\\\\\\n  // 3. CloudFront invalidation\\\\\\\\n  if (DIST_ID && invalidatePaths.length) {\\\\\\\\n    await cloudfront.send(\\\\\\\\n      new CreateInvalidationCommand({\\\\\\\\n        DistributionId: DIST_ID,\\\\\\\\n        InvalidationBatch: {\\\\\\\\n          CallerReference: `${Date.now()}`,\\\\\\\\n          Paths: {\\\\\\\\n            Quantity: 1,\\\\\\\\n            Items: [\\\\\\\\\\\\\\\"/news/*\\\\\\\\\\\\\\\"],\\\\\\\\n          },\\\\\\\\n        },\\\\\\\\n      })\\\\\\\\n    );\\\\\\\\n  }\\\\\\\\n\\\\\\\\n  return { statusCode: 200, processed: feed.length };\\\\\\\\n};\\\\\\\\n\\\\\\\\n/**\\\\\\\\n * Process a single markdown object: convert & store HTML, push to feed list.\\\\\\\\n */\\\\\\\\nconst processObject = async (\\\\\\\\n  bucket: string,\\\\\\\\n  obj: _Object,\\\\\\\\n  feed: FeedPost[],\\\\\\\\n  invalidatePaths: string[]\\\\\\\\n) => {\\\\\\\\n  if (!obj.Key) return;\\\\\\\\n  const { date, slug } = parseSourceKey(obj.Key);\\\\\\\\n\\\\\\\\n  // Read markdown\\\\\\\\n  const getResp = await s3.send(\\\\\\\\n    new GetObjectCommand({ Bucket: bucket, Key: obj.Key })\\\\\\\\n  );\\\\\\\\n  const markdown = await streamToString(getResp.Body as Readable);\\\\\\\\n\\\\\\\\n  // Convert to HTML\\\\\\\\n  const html = await mdToHtml(markdown);\\\\\\\\n\\\\\\\\n  // Destination key\\\\\\\\n  const [yyyy, mm, dd] = date.split(\\\\\\\\\\\\\\\"-\\\\\\\\\\\\\\\");\\\\\\\\n  const destKey = `news/${yyyy}/${mm}/${dd}/${slug}/index.html`;\\\\\\\\n\\\\\\\\n  // Write HTML (overwrites = idempotent)\\\\\\\\n  await s3.send(\\\\\\\\n    new PutObjectCommand({\\\\\\\\n      Bucket: bucket,\\\\\\\\n      Key: destKey,\\\\\\\\n      Body: html,\\\\\\\\n      ContentType: \\\\\\\\\\\\\\\"text/html; charset=utf-8\\\\\\\\\\\\\\\",\\\\\\\\n    })\\\\\\\\n  );\\\\\\\\n\\\\\\\\n  // Update feed entry\\\\\\\\n  feed.push({\\\\\\\\n    title: extractTitle(markdown, slug),\\\\\\\\n    url: `/${destKey}`,\\\\\\\\n    date,\\\\\\\\n  });\\\\\\\\n\\\\\\\\n  invalidatePaths.push(`/${destKey}`);\\\\\\\\n};\\\\\\\\n\\\\\\\\n/**\\\\\\\\n * =============================\\\\\\\\n *      jest tests (inline)\\\\\\\\n * =============================\\\\\\\\n * To execute (outside AWS), compile TS & run jest.  These tests mock S3 and CloudFront\\\\\\\\n * to verify that a markdown file is converted & stored correctly.\\\\\\\\n */\\\\\\\\n\\\\\\\\n/** jest tests **/\\\\\\\\n// @jest-environment node\\\\\\\\n\\\\\\\\n/* eslint-disable @typescript-eslint/no-var-requires */\\\\\\\\n/*\\\\\\\\nimport { handler, parseSourceKey, mdToHtml } from \\\\\\\\\\\\\\\"./index\\\\\\\\\\\\\\\";\\\\\\\\nimport { S3Client, PutObject