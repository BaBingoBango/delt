nfiguration Status=Enabled\\\\n```\\\\n\\\\nStep 2 – Create Docs Bucket (dunbaroakshoa-docs)\\\\n```\\\\naws s3api create-bucket --bucket \\\\\\\"$DOCS_BUCKET\\\\\\\" --create-bucket-configuration LocationConstraint=$REGION\\\\naws s3api put-bucket-encryption --bucket \\\\\\\"$DOCS_BUCKET\\\\\\\" \\\\\\\\\\\\n  --server-side-encryption-configuration '{\\\\\\\"Rules\\\\\\\":[{\\\\\\\"ApplyServerSideEncryptionByDefault\\\\\\\":{\\\\\\\"SSEAlgorithm\\\\\\\":\\\\\\\"AES256\\\\\\\"}}]}'\\\\naws s3api put-bucket-versioning --bucket \\\\\\\"$DOCS_BUCKET\\\\\\\" --versioning-configuration Status=Enabled\\\\naws s3api put-bucket-logging --bucket \\\\\\\"$DOCS_BUCKET\\\\\\\" \\\\\\\\\\\\n  --bucket-logging-status '{\\\\\\\"LoggingEnabled\\\\\\\":{\\\\\\\"TargetBucket\\\\\\\":\\\\\\\"'\\\\\\\"$LOGS_BUCKET\\\\\\\"'\\\\\\\",\\\\\\\"TargetPrefix\\\\\\\":\\\\\\\"docs/\\\\\\\"}}'\\\\naws s3api put-public-access-block --bucket \\\\\\\"$DOCS_BUCKET\\\\\\\" \\\\\\\\\\\\n  --public-access-block-configuration 'BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true'\\\\n```\\\\n\\\\nStep 3 – Deploy Cognito Stack via CloudFormation\\\\nCloudFormation template `cognito.yaml` (created by S-1) outputs \\\\nUserPoolId, IdentityPoolId, ResidentsRoleArn, BoardRoleArn.\\\\n```\\\\naws cloudformation deploy --stack-name cognito-stack \\\\\\\\\\\\n  --template-file cognito.yaml --capabilities CAPABILITY_NAMED_IAM\\\\nexport USER_POOL_ID=$(aws cloudformation describe-stacks --stack-name cognito-stack \\\\\\\\\\\\n  --query \\\\\\\"Stacks[0].Outputs[?OutputKey=='UserPoolId'].OutputValue\\\\\\\" --output text)\\\\nexport IDENTITY_POOL_ID=$(aws cloudformation describe-stacks --stack-name cognito-stack \\\\\\\\\\\\n  --query \\\\\\\"Stacks[0].Outputs[?OutputKey=='IdentityPoolId'].OutputValue\\\\\\\" --output text)\\\\nexport RESIDENTS_ROLE_ARN=$(aws cloudformation describe-stacks --stack-name cognito-stack \\\\\\\\\\\\n  --query \\\\\\\"Stacks[0].Outputs[?OutputKey=='ResidentsRoleArn'].OutputValue\\\\\\\" --output text)\\\\nexport BOARD_ROLE_ARN=$(aws cloudformation describe-stacks --stack-name cognito-stack \\\\\\\\\\\\n  --query \\\\\\\"Stacks[0].Outputs[?OutputKey=='BoardRoleArn'].OutputValue\\\\\\\" --output text)\\\\n```\\\\n\\\\nStep 4 – Attach Docs-Bucket Policy referencing Cognito Roles (generated JSON)\\\\n```\\\\ncat > docsBucketPolicy.json <<EOF\\\\n{\\\\n  \\\\\\\"Version\\\\\\\": \\\\\\\"2012-10-17\\\\\\\",\\\\n  \\\\\\\"Statement\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"Effect\\\\\\\": \\\\\\\"Allow\\\\\\\",\\\\n      \\\\\\\"Principal\\\\\\\": {\\\\\\\"AWS\\\\\\\": [\\\\\\\"$RESIDENTS_ROLE_ARN\\\\\\\",\\\\\\\"$BOARD_ROLE_ARN\\\\\\\"]},\\\\n      \\\\\\\"Action\\\\\\\": [\\\\\\\"s3:GetObject\\\\\\\"],\\\\n      \\\\\\\"Resource\\\\\\\": \\\\\\\"arn:aws:s3:::$DOCS_BUCKET/private/*\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"Effect\\\\\\\": \\\\\\\"Allow\\\\\\\",\\\\n      \\\\\\\"Principal\\\\\\\": {\\\\\\\"AWS\\\\\\\": \\\\\\\"$BOARD_ROLE_ARN\\\\\\\"},\\\\n      \\\\\\\"Action\\\\\\\": [\\\\\\\"s3:PutObject\\\\\\\",\\\\\\\"s3:DeleteObject\\\\\\\"],\\\\n      \\\\\\\"Resource\\\\\\\": \\\\\\\"arn:aws:s3:::$DOCS_BUCKET/private/*\\\\\\\"\\\\n    }\\\\n  ]\\\\n}\\\\nEOF\\\\naws s3api put-bucket-policy --bucket \\\\\\\"$DOCS_BUCKET\\\\\\\" --policy file://docsBucketPolicy.json\\\\n```\\\\n\\\\nStep 5 – Create DynamoDB Table (DunbarOaksContactMessages)\\\\n```\\\\naws dynamodb create-table \\\\\\\\\\\\n  --table-name DunbarOaksContactMessages \\\\\\\\\\\\n  --attribute-definitions AttributeName=PK,AttributeType=S AttributeName=TS,AttributeType=N \\\\\\\\\\\\n  --key-schema AttributeName=PK,KeyType=HASH AttributeName=TS,KeyType=RANGE \\\\\\\\\\\\n  --billing-mode PAY_PER_REQUEST\\\\n```\\\\n\\\\nStep 6 – Deploy API / Lambda Stack\\\\n(S-3 produces `api.yaml`; stack outputs RestApiId, ApiEndpoint)\\\\n```\\\\naws cloudformation deploy --stack-name api-stack --template-file api.yaml --capabilities CAPABILITY_NAMED_IAM\\