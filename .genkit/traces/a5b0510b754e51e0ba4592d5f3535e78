ys: false, // use bucket KMS encryption instead\\\\n      pipelineName: 'DunbarOaksCicdPipeline',\\\\n    });\\\\n\\\\n    const sourceArtifact = new cp.Artifact('Source');\\\\n    const buildArtifact  = new cp.Artifact('Build');\\\\n\\\\n    // SOURCE stage – GitHub via CodeStar Connections\\\\n    pipeline.addStage({\\\\n      stageName: 'Source',\\\\n      actions: [\\\\n        new cpa.CodeStarConnectionsSourceAction({\\\\n          actionName: 'GitHubSource',\\\\n          owner,\\\\n          repo,\\\\n          branch: 'main',\\\\n          connectionArn,\\\\n          output: sourceArtifact,\\\\n          triggerOnPush: true,\\\\n        })\\\\n      ]\\\\n    });\\\\n\\\\n    // BUILD stage – CodeBuild project using buildspec.yml\\\\n    const buildProject = new cb.Project(this, 'CdkBuildProject', {\\\\n      source: cb.Source.codePipeline({ artifact: sourceArtifact }),\\\\n      environment: {\\\\n        buildImage: cb.LinuxBuildImage.STANDARD_7_0,\\\\n        privileged: true, // allow Docker (CDK uses it for bundling at times)\\\\n      },\\\\n      cache: cb.Cache.bucket(new s3.Bucket(this, 'NpmCacheBucket', {\\\\n        encryption: s3.BucketEncryption.KMS_MANAGED,\\\\n        removalPolicy: RemovalPolicy.RETAIN,\\\\n        enforceSSL: true,\\\\n      })),\\\\n      buildSpec: cb.BuildSpec.fromSourceFilename('buildspec.yml'),\\\\n      timeout: Duration.minutes(30),\\\\n    });\\\\n\\\\n    pipeline.addStage({\\\\n      stageName: 'Build',\\\\n      actions: [\\\\n        new cpa.CodeBuildAction({\\\\n          actionName: 'BuildAndSynth',\\\\n          project: buildProject,\\\\n          input: sourceArtifact,\\\\n          outputs: [buildArtifact],\\\\n        })\\\\n      ]\\\\n    });\\\\n\\\\n    // DEPLOY stage – CDK CLI via CodeBuild (simplest way to run arbitrary shell)\\\\n    const deployProject = new cb.Project(this, 'CdkDeployProject', {\\\\n      source: cb.Source.codePipeline({ artifact: sourceArtifact }),\\\\n      environment: {\\\\n