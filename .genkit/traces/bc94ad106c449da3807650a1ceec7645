 wires together AWS security-baseline services exactly as specified:\\\\\\\\n1. GuardDuty\\\\\\\\n   • Creates and enables a detector in the current Region (GuardDuty is regional).\\\\\\\\n2. CloudTrail\\\\\\\\n   • Builds a multi-Region trail named `dhoa-org-trail`.\\\\\\\\n   • Delivers logs to the pre-existing S3 bucket `dunbaroakshoa-logs` (imported into the stack).  \\\\\\\\n3. AWS Config\\\\\\\\n   • Creates the required IAM service role.  \\\\\\\\n   • Establishes a delivery channel that also re-uses `dunbaroakshoa-logs`.  \\\\\\\\n   • Starts the configuration recorder (records ALL resources, incl. global types).  \\\\\\\\n   • Adds the two managed rules `s3-bucket-public-read-prohibited` and `iam-user-no-policies`.\\\\\\\\n4. Security Alerts\\\\\\\\n   • SNS topic `SecurityAlerts` plus an e-mail subscription (address taken from a stack parameter so it can be provided safely at deploy-time).  \\\\\\\\n   • CloudWatch metric sourced from namespace `AWS/GuardDuty`, metric name `High`, dimension `DetectorId=<id>`.  \\\\\\\\n   • Alarm fires whenever the sum of high-severity findings in a 5-minute window exceeds 0 and forwards the notification to the SNS topic.\\\\\\\\n5. Outputs\\\\\\\\n   • GuardDutyDetectorId  \\\\\\\\n   • TrailArn  \\\\\\\\n   • ConfigRecorderName  \\\\\\\\n   • AlertsTopicArn\\\\\\\\n\\\\\\\\nAll constructs use least-privilege managed policies or generated policies where appropriate.  Dependencies (e.g. recorder ↦ delivery channel) are explicitly set to avoid race conditions.\\\\\\\\n\\\\\\\\n--- File Content (security_stack.ts) ---\\\\\\\\n```typescript\\\\\\\\nimport { Stack, StackProps, Duration, CfnParameter, CfnOutput } from 'aws-cdk-lib';\\\\\\\\nimport { Construct } from 'constructs';\\\\\\\\nimport * as guardduty from 'aws-cdk-lib/aws-guardduty';\\\\\\\\nimport * as cloudtrail from 'aws-cdk-lib/aws-cloudtrail';\\\\\\\\nimport * as s3 from 'aws-cdk-lib/aws-s3';\\\\\\\\nimport * as config from 'aws-cdk-lib/aws-config';\\\\\\\\nimport * as sns from 'aws-cdk-lib/aws-sns';\\\\\\\\nimport * as snsSubs from 'aws-cdk-lib/aws-sns-subscriptions';\\\\\\\\nimport * as cw from 'aws-cdk-lib/aws-cloudwatch';\\\\\\\\nimport * as cw_actions from 'aws-cdk-lib/aws-cloudwatch-actions';\\\\\\\\nimport * as iam from 'aws-cdk-lib/aws-iam';\\\\\\\\n\\\\\\\\nexport class SecurityStack extends Stack {\\\\\\\\n  constructor(scope: Construct, id: string, props?: StackProps) {\\\\\\\\n    super(scope, id, props);\\\\\\\\n\\\\\\\\n    /* --------------------------------------------------\\\\\\\\n     *  Parameter: e-mail address for alert subscription\\\\\\\\n     * -------------------------------------------------- */\\\\\\\\n    const alertEmail = new CfnParameter(this, 'AlertEmail', {\\\\\\\\n      type: 'String',\\\\\\\\n      description: 'E-mail address to receive security alerts'\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    /* 1. ------------- GuardDuty Detector -------------- */\\\\\\\\n    const detector = new guardduty.CfnDetector(this, 'GuardDutyDetector', {\\\\\\\\n      enable: true\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    /* 2. ------------- CloudTrail Trail ---------------- */\\\\\\\\n    const logsBucket = s3.Bucket.fromBucketName(this, 'LogsBucket', 'dunbaroakshoa-logs');\\\\\\\\n\\\\\\\\n    const trail = new cloudtrail.Trail(this, 'OrgTrail', {\\\\\\\\n      trailName: 'dhoa-org-trail',\\\\\\\\n      bucket: logsBucket,\\\\\\\\n      isMultiRegionTrail: true,\\\\\\\\n      includeGlobalServiceEvents: true,\\\\\\\\n      enableFileValidation: true,\\\\\\\\n      managementEvents: cloudtrail.ReadWriteType.ALL\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    /* 3. ------------- AWS Config Setup ---------------- */\\\\\\\\n    const configRole = new iam.Role(this, 'ConfigRole', {\\\\\\\\n      assumedBy: new iam.ServicePrincipal('config.amazonaws.com'),\\\\\\\\n      managedPolicies: [\\\\\\\\n        iam.ManagedPolicy.fromAwsManagedPolicyName('service-role/AWS_ConfigRole')\\\\\\\\n      ]\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    const deliveryChannel = new config.CfnDeliveryChannel(this, 'ConfigDeliveryChannel', {\\\\\\\\n      s3BucketName: logsBucket.bucketName,\\\\\\\\n      configSnapshotDeliveryProperties: { deliveryFrequency: 'Six_Hours' }\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    const recorder = new config.CfnConfigurationRecorder(this, 'ConfigRecorder', {\\\\\\\\n      name: 'default',\\\\\\\\n      roleArn: configRole.roleArn,\\\\\\\\n      recordingGroup: {\\\\\\\\n        allSupported: true,\\\\\\\\n        includeGlobalResourceTypes: true\\\\\\\\n      }\\\\\\\\n    });\\\\\\\\n    recorder.addDependency(deliveryChannel);\\\\\\\\n\\\\\\\\n    // Managed Rules\\\\\\\\n    new config.ManagedRule(this, 'S3PublicReadProhibitedRule', {\\\\\\\\n      identifier: 'S3_BUCKET_PUBLIC_READ_PROHIBITED',\\\\\\\\n      configRuleName: 's3-bucket-public-read-prohibited'\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    new config.ManagedRule(this, 'IamUserNoPoliciesRule', {\\\\\\\\n      identifier: 'IAM_USER_NO_POLICIES_CHECK',\\\\\\\\n      configRuleName: 'iam-user-no-policies'\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    /* 4. ------------- SNS & Alarm --------------------- */\\\\\\\\n    const alertsTopic = new sns.Topic(this, 'SecurityAlertsTopic', {\\\\\\\\n      topicName: 'SecurityAlerts'\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    alertsTopic.addSubscription(new snsSubs.EmailSubscription(alertEmail.valueAsString));\\\\\\\\n\\\\\\\\n    const highFindingsMetric = new cw.Metric({\\\\\\\\n      namespace: 'AWS/GuardDuty',\\\\\\\\n      metricName: 'High',\\\\\\\\n      dimensionsMap: { DetectorId: detector.ref },\\\\\\\\n      statistic: 'Sum',\\\\\\\\n      period: Duration.minutes(5)\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    const highFindingsAlarm = new cw.Alarm(this, 'GuardDutyHighFindingsAlarm', {\\\\\\\\n      metric: highFindingsMetric,\\\\\\\\n      threshold: 0,\\\\\\\\n      evaluationPeriods: 1,\\\\\\\\n      comparisonOperator: cw.ComparisonOperator.GREATER_THAN_THRESHOLD,\\\\\\\\n      alarmDescription: 'Alarm when GuardDuty high-severity findings > 0',\\\\\\\\n      alarmName: 'GuardDuty-High-Severity-Findings'\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    highFindingsAlarm.addAlarmAction(new cw_actions.SnsAction(alertsTopic));\\\\\\\\n\\\\\\\\n    /* 5. ------------- Stack Outputs ------------------- */\\\\\\\\n    new CfnOutput(this, 'GuardDutyDetectorId', { value: detector.ref });\\\\\\\\n    new CfnOutput(this, 'TrailArn', { value: trail.trailArn });\\\\\\\\n    new CfnOutput(this, 'ConfigRecorderName', { value: recorder.name ?? 'default' });\\\\\\\\n    new CfnOutput(this, 'AlertsTopicArn', { value: alertsTopic.topicArn });\\\\\\\\n  }\\\\\\\\n}\\\\\\\\n```\\\\\\\\n\\\\\\\\n--- Deployment Notes ---\\\\\\\\n• Pass the desired alert e-mail address at deploy time:\\\\\\\\n  ```bash\\\\\\\\n  cdk deploy -c AlertEmail=user@example.com\\\\\\\\n  ```\\\\\\\\n• The S3 bucket `dunbaroakshoa-logs` must exist and allow CloudTrail and AWS Config writes (if not, appropriate bucket policy statements should be added).\\\\\\\\n• After deployment, the SNS confirmation mail must be accepted to start receiving alerts.\\\\\\\\n\\\\\\\\nEnd of report.\\\\\\\"\\\\n    }\\\\n  ]\\\\n}\\\"\\n}\\n###CALL_RESULTS-2025-07-22T01:33:22.508Z###\"}]},{\"role\":\"model\",\"content\":[{\"text\":\"###order_cicd_v1###\\nSYSTEM CALL\\nType: ORDER\\n\\n{\\n  \\\"orderString\\\": \\\"Supervisor – Add a new file cicd_stack.ts (CDK v2, TypeScript) plus supporting buildspec.yml that set up end-to-end CI/CD for our CDK application.\\\\n\\\\nRequirements\\\\n1. Code source: GitHub repo (owner + repo names passed in as context variables `GitHubOwner`, `GitHubRepo`).  Use branch `main`.\\\\n2. Pipeline stages:\\\\n   • Source  – GitHub (CodeStar connection) → artifact encryption ON.\\\\n   • Build   – CodeBuild project running `npm ci && npm run test && npx cdk synth` (use buildspec.yml).  Cache `~/.npm` for speed.\\\\n   • Deploy  – CDK deploy of all stacks in this order: cognito, s3, api, contact, security (use `cdk dep