\\\\\"Resource\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"*\\\\\\\\\\\\\\\"}]}'\\\\\\\\n\\\\\\\\n# Attach policy to role\\\\\\\\naws iam attach-role-policy --role-name ContactFormLambdaRole --policy-arn arn:aws:iam::725376125834:policy/ContactFormLambdaPolicy\\\\\\\\n\\\\\\\\n# --- 2. ContentHandlerLambdaRole --- \\\\\\\\n\\\\\\\\n# Role for Lambda to handle news, events, and other content\\\\\\\\naws iam create-role --role-name ContentHandlerLambdaRole --assume-role-policy-document '{\\\\\\\\\\\\\\\"Version\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"2012-10-17\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Statement\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"Effect\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Allow\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Principal\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"Service\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"lambda.amazonaws.com\\\\\\\\\\\\\\\"},\\\\\\\\\\\\\\\"Action\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"sts:AssumeRole\\\\\\\\\\\\\\\"}]}'\\\\\\\\n\\\\\\\\n# Policy for ContentHandlerLambdaRole\\\\\\\\naws iam create-policy --policy-name ContentHandlerLambdaPolicy --policy-document '{\\\\\\\\\\\\\\\"Version\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"2012-10-17\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Statement\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"Effect\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Allow\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Action\\\\\\\\\\\\\\\":[\\\\\\\\\\\\\\\"logs:CreateLogGroup\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"logs:CreateLogStream\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"logs:PutLogEvents\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\"Resource\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"arn:aws:logs:us-east-2:725376125834:log-group:/aws/lambda/ContentHandlerLambda:*\\\\\\\\\\\\\\\"},{\\\\\\\\\\\\\\\"Effect\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Allow\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Action\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"dynamodb:*\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Resource\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"arn:aws:dynamodb:us-east-2:725376125834:table/NewsEvents\\\\\\\\\\\\\\\"},{\\\\\\\\\\\\\\\"Effect\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Allow\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Action\\\\\\\\\\\\\\\":[\\\\\\\\\\\\\\\"s3:GetObject\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"s3:PutObject\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"s3:DeleteObject\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\"Resource\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"arn:aws:s3:::hoa-draft-001-content/*\\\\\\\\\\\\\\\"}]}'\\\\\\\\n\\\\\\\\n# Attach policy to role\\\\\\\\naws iam attach-role-policy --role-name ContentHandlerLambdaRole --policy-arn arn:aws:iam::725376125834:policy/ContentHandlerLambdaPolicy\\\\\\\\n\\\\\\\\n# --- 3. PageDataLambdaRole --- \\\\\\\\n\\\\\\\\n# Role for Lambda to fetch general page data (dues, meetings)\\\\\\\\naws iam create-role --role-name PageDataLambdaRole --assume-role-policy-document '{\\\\\\\\\\\\\\\"Version\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"2012-10-17\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Statement\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"Effect\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Allow\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Principal\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"Service\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"lambda.amazonaws.com\\\\\\\\\\\\\\\"},\\\\\\\\\\\\\\\"Action\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"sts:AssumeRole\\\\\\\\\\\\\\\"}]}'\\\\\\\\n\\\\\\\\n# Policy for PageDataLambdaRole\\\\\\\\naws iam create-policy --policy-name PageDataLambdaPolicy --policy-document '{\\\\\\\\\\\\\\\"Version\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"2012-10-17\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Statement\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"Effect\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Allow\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Action\\\\\\\\\\\\\\\":[\\\\\\\\\\\\\\\"logs:CreateLogGroup\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"logs:CreateLogStream\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"logs:PutLogEvents\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\"Resource\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"arn:aws:logs:us-east-2:725376125834:log-group:/aws/lambda/PageDataLambda:*\\\\\\\\\\\\\\\"},{\\\\\\\\\\\\\\\"Effect\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Allow\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Action\\\\\\\\\\\\\\\":[\\\\\\\\\\\\\\\"dynamodb:GetItem\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"dynamodb:Query\\\\\\\\\\