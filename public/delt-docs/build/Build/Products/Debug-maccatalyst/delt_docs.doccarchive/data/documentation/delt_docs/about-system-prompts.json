{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"About System Prompts","anchor":"About-System-Prompts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are technically four templates for every agent rank. The ranks are:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Chief"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Director"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Supervisor"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Attendant","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Senior Analyst","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Junior Analyst"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","level":3,"text":"Teaming","anchor":"Teaming"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each agent is randomly assigned a “team”. The teams are the four suits of a standard deck of cards:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hearts (red)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Diamonds (red)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Clubs (black)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Spades (black)"}],"type":"paragraph"}]}]},{"anchor":"Organization","level":3,"type":"heading","text":"Organization"},{"type":"paragraph","inlineContent":[{"text":"This folder contains one file for each rank. This prompt is then combined with the agent’s team prompt to create the final system prompt for the agent.","type":"text"}]}]}],"metadata":{"title":"About System Prompts","roleHeading":"Article","role":"article","modules":[{"name":"delt_docs"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.ethan-marshall.delt-docs\/do