{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"About-System-Prompts","type":"heading","text":"About System Prompts"},{"inlineContent":[{"text":"There are technically four templates for every agent rank. The ranks are:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Chief"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Director"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Supervisor"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Attendant"}]}]},{"content":[{"inlineContent":[{"text":"Senior Analyst","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Junior Analyst"}]}]}],"type":"orderedList"},{"text":"Teaming","anchor":"Teaming","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each agent is randomly assigned a “team”. The teams are the four suits of a standard deck of cards:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Hearts (red)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Diamonds (red)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Clubs (black)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Spades (black)","type":"text"}]}]}],"type":"unorderedList"},{"text":"Organization","anchor":"Organization","level":3,"type":"heading"},{"inlineContent":[{"text":"This folder contains one file for each rank. This prompt is then combined with the agent’s team prompt to create the final system prompt for the agent.","type":"text"}],"type":"paragraph"}]}],"metadata":{"title":"About System Prompts","modules":[{"name":"delt_docs"}],"roleHeading":"Article","role":"article"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.ethan-marshall.delt-docs\